# Copia este archivo a .env.local para desarrollo local (npm run dev)

# ─── Servidor — secretos (también acepta VITE_TURSO_* en local por compatibilidad) ───
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=
JWT_SECRET=genera_una_cadena_aleatoria_de_al_menos_32_caracteres

# Primer administrador (solo si la tabla users está vacía)
ADMIN_EMAIL=admin@tu-iglesia.com
ADMIN_PASSWORD=cambia_esta_contraseña_segura
ADMIN_NAME=Administrador

# Cron de cumpleaños (header: Authorization: Bearer <valor> o x-cron-secret)
CRON_SECRET=

# Web Push (servidor)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@tu-iglesia.com

# Google Login
VITE_GOOGLE_CLIENT_ID="TU_CLIENT_ID_DE_GOOGLE.apps.googleusercontent.com"

# ─── Cliente (Vite) — solo valores públicos ───
VITE_VAPID_PUBLIC_KEY=

# Proxy local: con "npm run dev:full" o "vercel dev" en puerto 3000
VITE_API_PROXY=http://127.0.0.1:3000

# URL pública de la app (para los enlaces en correos de restablecimiento)
# En producción Vercel se detecta automáticamente
VITE_APP_URL=http://localhost:5173

# ─── SMTP — correo para restablecimiento de contraseñas ───
# Ejemplos: smtp.gmail.com (Gmail), smtp.resend.com (Resend), smtp.sendgrid.net
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM=no-reply@tu-iglesia.com
